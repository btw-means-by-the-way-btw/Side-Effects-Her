# Local Docker PostgreSQL (`docker compose up -d db`)
DATABASE_URL=postgresql://sideeffecther:sideeffecther_dev@127.0.0.1:15432/sideeffecther
OPENFDA_API_KEY=
OPENAI_API_KEY=
# Optional; defaults to gpt-4o-mini, which supports Structured Outputs.
OPENAI_SYMPTOM_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
# Optional; defaults to deepseek/deepseek-v4.1-flash for exact-label phrase grouping only.
OPENROUTER_CLASSIFIER_MODEL=deepseek/deepseek-v4.1-flash
# Optional: literal Polish translations of public FDA paragraphs, separate from medical evidence.
OPENROUTER_TRANSLATION_MODEL=deepseek/deepseek-v4.1-flash

# Browser push: generate a fresh key pair with npx web-push generate-vapid-keys.
# Both are server-side; the public key is supplied to signed-in browsers by /api/push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@sideeffecther.local

# For hosted Supabase, replace this with its server-side PostgreSQL connection string.
